# Скопируйте в deploy/.env и задайте свой пароль. Файл .env в репозиторий не попадает.
# Пароль подставляется в URL подключения: только латинские буквы и цифры, от 24 символов.
POSTGRES_PASSWORD=замените-на-длинный-случайный-пароль
# Порт, на котором приложение доступно в локальной сети.
APP_PORT=8080
LOG_LEVEL=info
# Запросов в минуту с одного IP. Для прогона e2e с одной машины поднимите, например, до 100000.
RATE_LIMIT_MAX_PER_MINUTE=600
