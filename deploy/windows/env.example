# Настройки приложения для запуска на Windows без Docker. start.cmd копирует этот файл в .env в корне проекта.
# Пароль — тот, что задан пользователю label_stock в PostgreSQL. Только латинские буквы и цифры.
DATABASE_URL=postgres://label_stock:ЗАМЕНИТЕ-ПАРОЛЬ@localhost:5432/label_stock
# Порт в локальной сети. Его нужно разрешить в брандмауэре Windows (см. README).
PORT=8080
LOG_LEVEL=info
