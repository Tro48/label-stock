# Настройки приложения для запуска на Windows без Docker. setup.cmd копирует этот файл в .env
# в корне проекта и подставляет случайный пароль. Встроенный PostgreSQL слушает только 127.0.0.1.
DATABASE_URL=postgres://label_stock:GENERATED_BY_SETUP@127.0.0.1:5433/label_stock
# Порт в локальной сети. Его нужно разрешить в брандмауэре Windows (см. README).
PORT=8080
LOG_LEVEL=info
# Папка для backup.cmd, можно сетевую: \\nas\backup\label-stock
# BACKUP_DIR=D:\backup\label-stock
